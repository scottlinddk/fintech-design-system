{
  "name": "@scottlinddk/fintech-design-system",
  "version": "0.1.0",
  "description": "Shared design foundations for Funder, Portare and Investor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottlinddk/fintech-design-system.git"
  },
  "files": [
    "dist",
    "styles",
    "AGENTS.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./styles/index.css",
    "./themes/funder.css": "./styles/themes/funder.css",
    "./themes/portare.css": "./styles/themes/portare.css",
    "./themes/investor.css": "./styles/themes/investor.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test --run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "typescript": "^5.7.3",
    "vite-plus": "^1.5.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
