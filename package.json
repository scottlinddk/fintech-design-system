{
  "name": "@scttlnd/fintech-design-system",
  "version": "0.2.0",
  "description": "Shared design foundations for Funder, Portare and Investor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottlinddk/fintech-design-system.git"
  },
  "files": [
    "dist",
    "styles",
    "AGENTS.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./styles/index.css",
    "./grain.css": "./styles/grain.css",
    "./themes/funder.css": "./styles/themes/funder.css",
    "./themes/portare.css": "./styles/themes/portare.css",
    "./themes/investor.css": "./styles/themes/investor.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test --run",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version && vp check --fix",
    "release": "changeset publish",
    "prepublishOnly": "npm run build",
    "showcase:dev": "vp dev --config showcase/vite.config.ts",
    "showcase:build": "vp build --config showcase/vite.config.ts",
    "test:browser": "playwright test",
    "test:visual": "FDS_VISUAL=1 playwright test",
    "test:visual:update": "FDS_VISUAL=1 playwright test --update-snapshots",
    "test:package": "node scripts/check-build.mjs && node scripts/check-size.mjs",
    "smoke:next": "node scripts/smoke-next.mjs",
    "smoke:next:browser": "node scripts/verify-next.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "axe-core": "^4.14.0",
    "happy-dom": "^21.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite-plus": "^1.5.0",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
